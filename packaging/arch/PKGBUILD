# Maintainer: Ivan Koskov
pkgname=scrawl
pkgver=0.1.0
pkgrel=1
pkgdesc='Mouse-stroke gestures for any Linux Wayland compositor and X11'
arch=('x86_64' 'aarch64')
url='https://github.com/IvanKosk0v/scrawl'
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
optdepends=('libnotify: desktop notifications with feedback = "notify"')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f3d46eb15000b7d8e2f989795c6da78a4c352229ac7aefec7573d3e2646fcb8f')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/scrawl "$pkgdir/usr/bin/scrawl"
  install -Dm644 packaging/70-scrawl.rules "$pkgdir/usr/lib/udev/rules.d/70-scrawl.rules"
  install -Dm644 packaging/scrawl-deb.service "$pkgdir/usr/lib/systemd/user/scrawl.service"
  install -Dm644 packaging/config.example.toml "$pkgdir/usr/share/doc/scrawl/config.example.toml"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
